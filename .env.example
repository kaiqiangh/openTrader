APP_ENV=development
APP_NAME=open-trader
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
API_READ_ONLY_MODE=true
API_STRICT_DATABASE_MODE=true
API_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_DASHBOARD_URL=http://localhost:3000

# Core data infrastructure
POSTGRES_HOST=postgres_timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=open_trader
POSTGRES_USER=open_trader
POSTGRES_PASSWORD=change_me

REDIS_URL=redis://:${REDIS_PASSWORD:-}@redis:6379/0
REDIS_PASSWORD=<CHANGE_ME>
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=<CHANGE_ME>
RABBITMQ_DEFAULT_PASS=<CHANGE_ME>

# Exchange/runtime defaults
EXCHANGE_DEFAULT=binance
MARKET_EXCHANGES=binance,bitget
MARKET_SYMBOLS=BTC/USDT
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BITGET_BASE_URL=https://api.bitget.com
BITGET_WS_URL=wss://ws.bitget.com/v2/ws/public
# Market ingestion mode: rest (default, deterministic polling) or websocket.
MARKET_DATA_FETCH_MODE=rest
# REST polling cadence (seconds). 300 = every 5 minutes.
MARKET_DATA_REST_POLL_SECONDS=300
ORDERBOOK_SNAPSHOT_INTERVAL_SECONDS=180
MARKET_DATA_HTTP_TIMEOUT_SECONDS=10.0
KLINE_INTERVALS=1m
KLINE_POLL_INTERVAL_SECONDS=60
KLINE_FETCH_LIMIT=200
EXECUTION_MODE_DEFAULT=MOCK
SIMULATION_SLIPPAGE_BPS=3.0
SIMULATION_FEE_BPS=5.0

# LLM gateway runtime configuration (consumed directly by openTrader runtime)
# LLM provider configuration (direct API to DeepSeek/OpenAI-compatible endpoint)
LLM_RUNTIME_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15.0
LLM_MODEL=deepseek-chat
# Provider routing: "default" = direct API, add aliases for multi-provider setups
LLM_QUICK_PROVIDER_ORDER=default
LLM_DEEP_PROVIDER_ORDER=default

# OMS/runtime behavior
OMS_RECONCILIATION_STALE_AFTER_SECONDS=5.0
OMS_PORTFOLIO_BASE_BALANCE_USD=100000.0
AGENT_DECISION_TTL_SECONDS=900
NEWS_SOURCE_MODE=real
NEWS_RSS_FEEDS=https://www.cryptopolitan.com/feed/,https://www.newsbtc.com/feed/
NEWS_FETCH_TIMEOUT_SECONDS=8.0

# Runtime worker and broker defaults (Phase 10)
RUNTIME_REQUIRE_DATABASE=true
RUNTIME_BROKER_BACKEND=rabbitmq_http
RUNTIME_RABBITMQ_HTTP_API_URL=http://rabbitmq:15672/api
RUNTIME_BROKER_HTTP_TIMEOUT_SECONDS=2.0
RUNTIME_WORKER_POLL_TIMEOUT_SECONDS=0.5
RUNTIME_WORKER_IDLE_SLEEP_SECONDS=0.5

# Real execution bridge wiring
REAL_EXECUTION_QUEUE_NAME=execution.intent.real
REAL_EXECUTION_BRIDGE_URL=http://api:8000/internal/execution/dispatch
REAL_EXECUTION_BRIDGE_TIMEOUT_MS=3000
REAL_EXECUTION_BRIDGE_API_KEY=

# Notification placeholders (Telegram-first architecture)
NOTIFY_ENABLED=true
NOTIFY_DEFAULT_GATEWAY=telegram
NOTIFY_QUEUE_NAME=notify.events.raw
NOTIFY_CONSUMER_BACKEND=rabbitmq_http
NOTIFY_RABBITMQ_HTTP_API_URL=http://rabbitmq:15672/api
NOTIFY_POLL_TIMEOUT_SECONDS=1.0
NOTIFY_IDLE_SLEEP_SECONDS=0.5
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
NOTIFICATION_DEFAULT_SEVERITY=WARNING
NOTIFY_GATEWAY_TIMEOUT_SECONDS=10.0
NOTIFY_RATE_LIMIT_PER_MIN=30
NOTIFY_DEDUPE_WINDOW_SECONDS=120
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_BACKOFF_BASE_SECONDS=0.2
NOTIFY_BACKOFF_MULTIPLIER=2.0
NOTIFY_BACKOFF_MAX_SECONDS=2.0
NOTIFY_OBSERVABILITY_MAX_RECORDS=200

# Security and auth
ENCRYPTION_KEY_BASE64=
JWT_PRIVATE_KEY=  # PEM-encoded RSA private key for RS256 signing (preferred)
JWT_PUBLIC_KEY=   # PEM-encoded RSA public key for RS256 verification (preferred)
JWT_ISSUER=open-trader
JWT_AUDIENCE=open-trader-api

# Observability stack
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_HOST_PORT=3001

# Email notification gateway (SMTP)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_FROM_ADDRESS=
EMAIL_DEFAULT_RECIPIENTS=
EMAIL_TIMEOUT_SECONDS=15.0

# Webhook notification gateway
WEBHOOK_URL=
WEBHOOK_SECRET=
