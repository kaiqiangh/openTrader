{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentrader.local/contracts/message_envelope.schema.json",
  "title": "Canonical Message Envelope",
  "type": "object",
  "required": [
    "trace_id",
    "decision_id",
    "mode",
    "idempotency_key",
    "event_type",
    "emitted_at",
    "payload"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "mode": {
      "type": "string",
      "enum": ["MOCK", "REAL"]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "additionalProperties": false
}
