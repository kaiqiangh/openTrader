{
  "version": 1,
  "exchanges": [
    {"name": "market.events", "type": "topic", "durable": true},
    {"name": "strategy.events", "type": "topic", "durable": true},
    {"name": "execution.events", "type": "topic", "durable": true},
    {"name": "oms.events", "type": "topic", "durable": true},
    {"name": "notify.events", "type": "topic", "durable": true},
    {"name": "dead.letter", "type": "topic", "durable": true}
  ],
  "queues": [
    {
      "name": "market.canonical",
      "durable": true,
      "arguments": {
        "x-dead-letter-exchange": "dead.letter",
        "x-dead-letter-routing-key": "dlq.market.canonical"
      }
    },
    {
      "name": "strategy.events.lifecycle",
      "durable": true,
      "arguments": {
        "x-dead-letter-exchange": "dead.letter",
        "x-dead-letter-routing-key": "dlq.strategy.events.lifecycle"
      }
    },
    {
      "name": "execution.intent.mock",
      "durable": true,
      "arguments": {
        "x-dead-letter-exchange": "dead.letter",
        "x-dead-letter-routing-key": "dlq.execution.intent.mock"
      }
    },
    {
      "name": "execution.intent.real",
      "durable": true,
      "arguments": {
        "x-dead-letter-exchange": "dead.letter",
        "x-dead-letter-routing-key": "dlq.execution.intent.real"
      }
    },
    {
      "name": "execution.intent.real.lifecycle",
      "durable": true,
      "arguments": {
        "x-dead-letter-exchange": "dead.letter",
        "x-dead-letter-routing-key": "dlq.execution.intent.real.lifecycle"
      }
    },
    {
      "name": "oms.events.order_updates",
      "durable": true,
      "arguments": {
        "x-dead-letter-exchange": "dead.letter",
        "x-dead-letter-routing-key": "dlq.oms.events.order_updates"
      }
    },
    {
      "name": "notify.events.raw",
      "durable": true,
      "arguments": {
        "x-dead-letter-exchange": "dead.letter",
        "x-dead-letter-routing-key": "dlq.notify.events.raw"
      }
    },
    {"name": "dlq.execution.intent.real", "durable": true},
    {"name": "dlq.execution.intent.real.lifecycle", "durable": true},
    {"name": "dlq.execution.intent.mock", "durable": true},
    {"name": "dlq.strategy.events.lifecycle", "durable": true},
    {"name": "dlq.market.canonical", "durable": true},
    {"name": "dlq.oms.events.order_updates", "durable": true},
    {"name": "dlq.notify.events.raw", "durable": true}
  ],
  "bindings": [
    {
      "exchange": "market.events",
      "queue": "market.canonical",
      "routing_key": "market.canonical"
    },
    {
      "exchange": "strategy.events",
      "queue": "strategy.events.lifecycle",
      "routing_key": "strategy.decision.#"
    },
    {
      "exchange": "execution.events",
      "queue": "execution.intent.mock",
      "routing_key": "execution.intent.mock"
    },
    {
      "exchange": "execution.events",
      "queue": "execution.intent.real",
      "routing_key": "execution.intent.real"
    },
    {
      "exchange": "execution.events",
      "queue": "execution.intent.real.lifecycle",
      "routing_key": "execution.intent.real"
    },
    {
      "exchange": "oms.events",
      "queue": "oms.events.order_updates",
      "routing_key": "oms.order.*"
    },
    {
      "exchange": "notify.events",
      "queue": "notify.events.raw",
      "routing_key": "notify.#"
    },
    {
      "exchange": "dead.letter",
      "queue": "dlq.execution.intent.real",
      "routing_key": "dlq.execution.intent.real"
    },
    {
      "exchange": "dead.letter",
      "queue": "dlq.execution.intent.real.lifecycle",
      "routing_key": "dlq.execution.intent.real.lifecycle"
    },
    {
      "exchange": "dead.letter",
      "queue": "dlq.execution.intent.mock",
      "routing_key": "dlq.execution.intent.mock"
    },
    {
      "exchange": "dead.letter",
      "queue": "dlq.strategy.events.lifecycle",
      "routing_key": "dlq.strategy.events.lifecycle"
    },
    {
      "exchange": "dead.letter",
      "queue": "dlq.market.canonical",
      "routing_key": "dlq.market.canonical"
    },
    {
      "exchange": "dead.letter",
      "queue": "dlq.oms.events.order_updates",
      "routing_key": "dlq.oms.events.order_updates"
    },
    {
      "exchange": "dead.letter",
      "queue": "dlq.notify.events.raw",
      "routing_key": "dlq.notify.events.raw"
    }
  ]
}
