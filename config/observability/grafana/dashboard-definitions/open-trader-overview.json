      "title": "API Requests Total",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (open_trader_http_requests_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
